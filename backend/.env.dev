# ZenTaap — local development
MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="zentapdb"

# Demo mode for local testing (OTP returned by /auth/request-otp)
DEMO_MODE="true"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Razorpay — leave empty for local (checkout disabled until keys set)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PAYMENT_LINK=""

# Frontend QR domain (used inside QR codes)
ZENTAAP_QR_DOMAIN="http://localhost:3000"
