# ZenTaap — local development
MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="zentapdb"

# Demo mode for local testing (OTP returned by /auth/request-otp)
DEMO_MODE="true"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Razorpay — leave empty for local (checkout disabled until keys set)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PAYMENT_LINK=""

# OTP SMS via 2Factor.in (https://2factor.in)
# Paste your API key in TWOFACTOR_API_KEY.
# TWOFACTOR_OTP_TEMPLATE must match an approved SMS template in 2Factor
# (OTP Services → Manage OTP Templates). Empty template = voice call, not SMS.
TWOFACTOR_API_KEY=""
TWOFACTOR_OTP_TEMPLATE="ZENTAAP"
TWOFACTOR_COUNTRY_CODE="91"

# OTP email via Gmail SMTP — fallback if 2Factor is not set
# Create at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS="true"

# Frontend QR domain (used inside QR codes)
ZENTAAP_QR_DOMAIN="http://localhost:3000"

# Platform admin panel — http://localhost:3000/admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
